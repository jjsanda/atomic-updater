#!/bin/sh
# Fake systemctl: records the invocation.
#   is-active — exit 0 when FAKE_SYSTEMCTL_ACTIVE=1, else 3 (inactive)
#   reboot    — recorded only, exit 0
if [ $# -gt 0 ]; then line="systemctl $*"; else line="systemctl"; fi
echo "$line" >> "${FAKE_LOG:?FAKE_LOG not set}"
case "${1:-}" in
    is-active)
        if [ "${FAKE_SYSTEMCTL_ACTIVE:-1}" = "1" ]; then
            exit 0
        fi
        exit 3
        ;;
    reboot)
        exit 0
        ;;
esac
exit 0
