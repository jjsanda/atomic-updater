# NOTE: authored for the org CI runners; NOT built/validated in this workspace.
# wic kickstart — x86-64 EFI (qemux86-64 / generic mini-PC), design.md §7.1
# four-partition scheme on a GPT table.
#
# GPT partition names (--part-name) are what /etc/rauc/system.conf resolves
# via /dev/disk/by-partlabel/rootfs.A|B|data
# (recipes-rauc/rauc/files/x86-64/system.conf); --label additionally sets
# filesystem labels for debugging.
#
# Partition 1 is the ESP (GRUB via bootimg-efi). A/B selection is done by
# the RAUC efi backend through efibootmgr (design.md §6.2); the EFI boot
# entries labeled "A" and "B" are created once at provisioning time — see
# README "validate first".
# VERIFY-ON-BUILDER: if the target firmware is strict about the ESP type
# GUID, add --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B to the /boot
# line (OVMF for qemux86-64 boots the canned bootimg-efi layout as-is).
#
# --no-fstab-update everywhere: runtime mounts are owned by the rofs-overlays
# systemd units. "data" is grown to disk end at provisioning (see the rpi
# .wks.in note).

part /boot --source bootimg-efi --sourceparams="loader=grub-efi" --ondisk sda --fstype=vfat --label boot --part-name boot --active --align 1024 --fixed-size 128M --no-fstab-update

part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs.A --part-name rootfs.A --align 1024 --fixed-size 2G --no-fstab-update

# slot B is byte-identical to slot A at flash time (same image rootfs)
part --source rootfs --ondisk sda --fstype=ext4 --label rootfs.B --part-name rootfs.B --align 1024 --fixed-size 2G --no-fstab-update

part /data --ondisk sda --fstype=ext4 --label data --part-name data --align 1024 --size 512M --no-fstab-update

bootloader --ptable gpt --timeout 2 --append "ro rootwait console=ttyS0,115200 console=tty0"
