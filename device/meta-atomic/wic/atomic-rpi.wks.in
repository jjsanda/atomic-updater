# NOTE: authored for the org CI runners; NOT built/validated in this workspace.
# wic kickstart — Raspberry Pi CM4 (raspberrypi4-64), design.md §7.1
# four-partition scheme on an MBR (msdos) table.
#
# DOCUMENTED DECISION: msdos, not gpt — the RPi firmware boot path is only
# dependable with an MBR table on the CM4 fleet baseline, and design.md §7.3
# addresses slots as /dev/mmcblk0p2 / p3 (raw partition numbers, no GPT
# part-labels). Exactly 4 primary partitions -> stable p1..p4 numbering.
# The --label values below set ext4 FILESYSTEM labels (cosmetic/debug aid);
# RAUC and the mount units use the raw device paths.
#
# --no-fstab-update everywhere: runtime mounts are owned by the rofs-overlays
# systemd units, not by /etc/fstab.
#
# p4 "data" is created at a fixed 512M; ON FIRST PROVISIONING the partition
# is grown to the disk end (parted resizepart + resize2fs, or systemd-repart)
# — wic has no "grow to end" primitive. Documented in docs/operations.md.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --fixed-size 128M --no-fstab-update

part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs.A --align 4096 --fixed-size 2G --no-fstab-update

# slot B is byte-identical to slot A at flash time (same image rootfs)
part --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs.B --align 4096 --fixed-size 2G --no-fstab-update

part /data --ondisk mmcblk0 --fstype=ext4 --label data --align 4096 --size 512M --no-fstab-update

bootloader --ptable msdos
