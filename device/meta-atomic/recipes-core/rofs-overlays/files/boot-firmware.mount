# NOTE: authored for the org CI runners; NOT built/validated in this workspace.
# rpi only: FAT boot partition (RPi firmware + u-boot.bin + uboot.env) at
# /boot/firmware, rw so fw_setenv/atomic-health can update BOOT_x_LEFT and
# BOOT_ORDER (design.md §7.2). Matches /etc/fw_env.config
# (recipes-bsp/u-boot/files/fw_env.config).
# @ATOMIC_BOOTFW_DEVICE@ is substituted at do_install time (/dev/mmcblk0p1).

[Unit]
Description=RPi boot firmware partition (/boot/firmware)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=@ATOMIC_BOOTFW_DEVICE@
Where=/boot/firmware
Type=vfat
Options=rw,noatime,fmask=0022,dmask=0022

[Install]
WantedBy=local-fs.target
