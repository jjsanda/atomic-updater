# NOTE: authored for the org CI runners; NOT built/validated in this workspace.
# Bind-mount /home from the data partition (design.md §7.1). /data/home is
# seeded once from the pristine rootfs /home by atomic-data-seed.service.

[Unit]
Description=Persistent /home from /data
DefaultDependencies=no
Conflicts=umount.target
Requires=data.mount atomic-data-seed.service
After=data.mount atomic-data-seed.service
Before=local-fs.target umount.target

[Mount]
What=/data/home
Where=/home
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
