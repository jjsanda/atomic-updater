# NOTE: authored for the org CI runners; NOT built/validated in this workspace.
# design.md §7.1: partition 4 "data" (ext4, rw) -> /data.
# @ATOMIC_DATA_DEVICE@ is substituted at do_install time:
#   x86 GPT: /dev/disk/by-partlabel/data   rpi MBR: /dev/mmcblk0p4

[Unit]
Description=Persistent data partition (/data)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=@ATOMIC_DATA_DEVICE@
Where=/data
Type=ext4
Options=defaults,noatime
# Partition growth to disk end is a provisioning-time step (see
# wic/atomic-*.wks.in comments); x-systemd.growfs only grows the
# filesystem, not the partition, so it is not set here.

[Install]
WantedBy=local-fs.target
