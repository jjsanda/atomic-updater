# NOTE: authored for the org CI runners; NOT built/validated in this workspace.
# atomic-agent systemd unit (design.md §7.5).

[Unit]
Description=atomic-updater check-in agent
Documentation=file:///usr/share/doc/atomic-updater/design.md
Wants=network-online.target
After=network-online.target
# Device certificate, pending bundle download and agent state live on /data
RequiresMountsFor=/data/atomic-updater

[Service]
Type=simple
ExecStart=/usr/bin/atomic-agent
Restart=always
RestartSec=10
# VERIFY-ON-BUILDER: flag/env names must match the device/agent
# implementation (state dir, server URL, cert paths).
Environment=ATOMIC_AGENT_STATE_DIR=/data/atomic-updater

[Install]
WantedBy=multi-user.target
